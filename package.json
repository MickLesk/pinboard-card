{
  "name": "pinboard-card",
  "version": "1.2.1",
  "description": "Home Assistant dashboard card that pairs a picture with a note and flips between them.",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "verify": "node --check dist/pinboard-card.js && node scripts/verify_bundle.mjs",
    "validate": "npm run typecheck && npm run build && npm run verify && npm test",
    "demo": "node scripts/serve_demo.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "playwright": "1.63.0"
  }
}
